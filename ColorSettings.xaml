<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RTCChat.ColorSettings"
             Title="ColorSettings">
    <Grid Margin="26" RowDefinitions="auto,auto,auto,*,auto" RowSpacing="20">
        <Label Text="Тема приложения" HorizontalTextAlignment="Center" Grid.Row="0"/>
        <Border StrokeShape="RoundRectangle 20" HeightRequest="40" Grid.Row="1">
            <Border.Content>
                <Grid ColumnDefinitions="*,*,*">
                    <Border Grid.Column="0" BackgroundColor="Transparent">
                        <Border.Content>
                            <Label Text="Light" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        </Border.Content>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeThemeCommand}" CommandParameter="1"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Theme}" Value="1">
                                <Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="Transparent">
                        <Border.Content>
                            <Label Text="System" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        </Border.Content>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeThemeCommand}" CommandParameter="0"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Theme}" Value="0">
                                <Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>

                    <Border Grid.Column="2" BackgroundColor="Transparent">
                        <Border.Content>
                            <Label Text="Dark" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        </Border.Content>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeThemeCommand}" CommandParameter="2"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Theme}" Value="2">
                                <Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
            </Border.Content>
        </Border>

        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="auto,auto" RowSpacing="40" Grid.Row="2">
            <Border Style="{StaticResource ContrastBorder1}" Stroke="{StaticResource Contrast1}" WidthRequest="40" HeightRequest="40" Grid.Column="0" Grid.Row="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetColorCommand}" CommandParameter="Contrast1"/>
                </Border.GestureRecognizers>
            </Border>
            <Border Style="{StaticResource ContrastBorder1}" Stroke="{StaticResource Contrast2}" WidthRequest="40" HeightRequest="40" Grid.Column="1" Grid.Row="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetColorCommand}" CommandParameter="Contrast2"/>
                </Border.GestureRecognizers>
            </Border>
            <Border Style="{StaticResource ContrastBorder1}" Stroke="{StaticResource Contrast3}" WidthRequest="40" HeightRequest="40" Grid.Column="2" Grid.Row="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetColorCommand}" CommandParameter="Contrast3"/>
                </Border.GestureRecognizers>
            </Border>
            <Border Style="{StaticResource ContrastBorder1}" Stroke="{StaticResource Contrast4}" WidthRequest="40" HeightRequest="40" Grid.Column="3" Grid.Row="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetColorCommand}" CommandParameter="Contrast4"/>
                </Border.GestureRecognizers>
            </Border>
            <Border Style="{StaticResource ContrastBorder1}" Stroke="{StaticResource Contrast5}" WidthRequest="40" HeightRequest="40" Grid.Column="0" Grid.Row="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetColorCommand}" CommandParameter="Contrast5"/>
                </Border.GestureRecognizers>
            </Border>
            <Border Style="{StaticResource ContrastBorder1}" Stroke="{StaticResource Contrast6}" WidthRequest="40" HeightRequest="40" Grid.Column="1" Grid.Row="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetColorCommand}" CommandParameter="Contrast6"/>
                </Border.GestureRecognizers>
            </Border>
            <Border Style="{StaticResource ContrastBorder1}" Stroke="{StaticResource Contrast7}" WidthRequest="40" HeightRequest="40" Grid.Column="2" Grid.Row="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetColorCommand}" CommandParameter="Contrast7"/>
                </Border.GestureRecognizers>
            </Border>
            <Border Style="{StaticResource ContrastBorder1}" Stroke="{StaticResource Contrast8}" WidthRequest="40" HeightRequest="40" Grid.Column="3" Grid.Row="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SetColorCommand}" CommandParameter="Contrast8"/>
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <Entry Placeholder="IP" Text="{Binding Ip}" Grid.Row="3" TextChanged="ChangeIP"/>

        <Button Text="Применить" Style="{StaticResource ContrastButton}" Command="{Binding ApplyCommand}" Grid.Row="4"/>
    </Grid>
</ContentPage>