<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RTCChat.MainPageV2">

    <Grid>
        <Grid RowSpacing="60" Margin="26,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center">
                <HorizontalStackLayout HorizontalOptions="Center">
                    <!--<Image Source="ellipse1.png" VerticalOptions="Center"/>-->
                    <Label Text="Bair" FontSize="64" FontFamily="Irish"/>
                </HorizontalStackLayout>
                <Label Text="{Binding Title}" FontSize="24" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" VerticalOptions="End" Spacing="20">
                <Border Style="{StaticResource ElementBorder}" Margin="0,50">
                    <Border.Content>
                        <VerticalStackLayout>
                            <Entry Placeholder="Логин" Text="{Binding Login}" ClearButtonVisibility="WhileEditing" Unfocused="ChangeLogin"/>
                        </VerticalStackLayout>
                    </Border.Content>
                </Border>
                <Button Style="{StaticResource ContrastButton}" Text="Войти в комнату" Clicked="Join"/>
                <Button Style="{StaticResource ContrastButton2}" Text="Создать комнату" Command="{Binding CreateCommand}"/>
                <Label Style="{StaticResource Mini}" Text="Beta" HorizontalTextAlignment="Center" Margin="0,20"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Overlay -->
        <Grid IsVisible="{Binding IsOverlay}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseOverlayCommand}"/>
            </Grid.GestureRecognizers>

            <Border BackgroundColor="{StaticResource TBackground}">

                <Border.Content>
                    <Grid RowDefinitions="*,Auto,*" ColumnDefinitions="0.1*,0.8*,0.1*">

                        <Border x:Name="OverlayBorder" Style="{StaticResource ElementBorder}" Padding="10" Grid.Row="1"  Grid.Column="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PassCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>

                    </Grid>
                </Border.Content>
            </Border>
        </Grid>
    </Grid>

</ContentPage>